# Copy this file to deployments/.env for local Docker Compose development.
# Never commit real passwords, keys, or payment secrets.
MINIMALL_ENV=dev
MYSQL_ROOT_PASSWORD=CHANGE_ME
MINIMALL_MYSQL_USER=minimall
MINIMALL_MYSQL_PASSWORD=CHANGE_ME
MINIMALL_JWT_HS_SECRET=CHANGE_ME
MINIMALL_NATS_URL=nats://nats:4222
MINIMALL_REDIS_ADDR=redis:6379
MINIMALL_SEARCH_OPENSEARCH_URL=http://opensearch:9200
MINIMALL_PAYMENT_MOCK=true
